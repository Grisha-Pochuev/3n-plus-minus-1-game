*.jsonl
.DS_Store

# Lean/Lake build products (sources and lock files stay tracked)
formal/.lake/

# LaTeX build intermediates (the reviewed paper/main.pdf remains tracked)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out

# Rendered audit previews and LaTeX intermediates are reproducible.  Keep only
# the final reviewed PDF needed by readers of a clean clone.
output/*
!output/pdf/
output/pdf/*
!output/pdf/audit_ready_reduction.pdf
